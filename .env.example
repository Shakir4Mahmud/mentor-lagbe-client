# Secrets: rotate before production. Never prefix a secret with NEXT_PUBLIC_.
MONGODB_URI=your_mongodb_connection_string
BETTER_AUTH_SECRET=a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
# Must match the server's JWT_SECRET exactly (change both sides together).
JWT_SECRET=same_secret_as_the_server
# The only intentionally public value.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Google OAuth (optional). Redirect URI must be:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Public UI flag. Set to "true" only after both keys above are configured.
# This value is inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
# Email delivery (Resend). Server-only.
RESEND_API_KEY=your_resend_api_key
# Testing: onboarding@resend.dev. Production: a verified domain address.
EMAIL_FROM=MentorLagbe <onboarding@resend.dev>
# Server-only: never prefix with NEXT_PUBLIC_
IMGBB_KEY=your_imgbb_api_key